<?xml version="1.0" encoding="utf-8"?>
<!-- 테마 아이콘(Android 13+)용 단색 층: 고양이 귀 달력 실루엣, 날짜 칸은 구멍. 색은 시스템이 칠하고 모양(알파)만 쓴다 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FF000000"
        android:pathData="@string/ic_cal_ear_left_path" />
    <path
        android:fillColor="#FF000000"
        android:pathData="@string/ic_cal_ear_right_path" />
    <path
        android:fillColor="#FF000000"
        android:fillType="evenOdd"
        android:pathData="@string/ic_cal_body_with_holes_path" />
</vector>
